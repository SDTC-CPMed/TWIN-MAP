# Copy this file to paths.env (not tracked by git) and set the folders on your machine.
# One NAME=path per line, no quotes needed; ~ is expanded. Environment variables of the same name override these.
# A script needs only the folders it uses; the README lists which scripts read which folder.

# Single-cell data and results root: Prostate Cancer/, CRC/, LuCa/, Robustness/ and the figure folders
EARLYT_DATA=~/path/to/PseudoTime/Data and Results

# UK Biobank server: model inputs, and outputs under UKBB_Results/ (UKBB/models/)
EARLYT_UKBB_SERVER=~/path/to/ukbb/data

# Local copy of the UK Biobank result folders (<cancer>_experiment_final_v3/, LUAD_LuCA_moran_top20_v3/)
EARLYT_UKBB_RESULTS=~/path/to/UKBB_Results

# Output folder for the UK Biobank tables and figures, and the supplementary figures (luca_regen_20261106/, ...)
EARLYT_HANDOFF=~/path/to/EARLY_T_handoff

# Prong 3B folder (enrichment_prong3B/): holds the input folder from the pseudotime runs and Output/
EARLYT_PRONG3B=~/path/to/Prong3B

# Inputs to UKBB/summaries_tables/make_supplementary_tables_xlsx_luca.R only
EARLYT_OVERLEAF_ZIP=~/path/to/Early_T_20261104.zip
EARLYT_LUCA_EDITS=~/path/to/MANUSCRIPT_EDITS_LuCA_20261106.md
